# Local development values only. Replace before using any shared or deployed environment.
POSTGRES_USER=classpulse
POSTGRES_PASSWORD=change-me-before-deploy
POSTGRES_DB=classpulse
POSTGRES_PORT=5433

# Host-side URL. Docker Compose overrides the host with its PostgreSQL service name.
DATABASE_URL=postgresql+psycopg://classpulse:change-me-before-deploy@localhost:5433/classpulse
APP_ENV=development
AI_PROVIDER=mock
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=your_provider_model_id
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=20
AI_BATCH_TIMEOUT_SECONDS=45

# Direct Google Gemini (set AI_PROVIDER=gemini to enable)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_SECONDS=45
